{
  "server": {
    "name": "QUIK Production",
    "ip": "172.23.10.82"
  },
  "timezone": "Asia/Bishkek",

  "intervals": {
    "processSec": 15,
    "serviceSec": 30,
    "systemSec": 30,
    "networkSec": 30,
    "eventLogSec": 300
  },

  "confirm": {
    "failChecks": 2,
    "recoverChecks": 2,
    "resourceChecks": 3
  },

  "thresholds": {
    "cpu": { "warning": 85, "critical": 95 },
    "ram": { "warning": 85, "critical": 95 },
    "diskFree": { "warning": 15, "critical": 5 },
    "hysteresis": 5,
    "diskHysteresis": 1
  },

  "disks": ["C:\\"],

  "processes": [],
  "services": [],
  "ports": [],

  "eventLog": {
    "enabled": true,
    "sources": [
      { "log": "System", "levels": [1, 2] }
    ],
    "maxItemsInAlert": 5
  },

  "maintenanceWindows": [],

  "history": { "retentionDays": 180 },

  "heartbeat": { "enabled": false, "intervalSec": 60 }
}
