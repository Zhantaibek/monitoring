{
  "name": "quik-server-monitor",
  "version": "0.1.0",
  "description": "Read-only мониторинг боевого сервера QUIK с уведомлениями в Telegram",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "check-once": "node --disable-warning=ExperimentalWarning dist/index.js --once",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test \"dist/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "https-proxy-agent": "^9.1.0",
    "pino": "^10.4.0",
    "pino-roll": "^4.0.0",
    "telegraf": "^4.16.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
