# Скопируйте в .env и заполните. Файл .env не коммитить и не передавать.
# Права на .env: только администраторы и учётная запись службы.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Ваш числовой Telegram ID (узнать: @userinfobot). Только этот пользователь
# получает уведомления и может выполнять команды.
TELEGRAM_ADMIN_ID=

# Необязательно: HTTP(S)-прокси, если сервер выходит в интернет только через прокси.
# Пример: http://proxy.local:3128
TELEGRAM_PROXY_URL=

# Необязательно: URL внешнего монитора для heartbeat (dead man's switch),
# например push-монитор Uptime Kuma во внутренней сети. Пусто = выключено.
HEARTBEAT_URL=

# Необязательно: переопределение путей и уровня логирования
# CONFIG_PATH=config/config.json
# DATA_DIR=data
# LOG_DIR=logs
# LOG_LEVEL=info
