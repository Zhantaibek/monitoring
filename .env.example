# Скопируйте в .env и заполните. Файл .env не коммитить и не передавать.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram ID админов (узнать: @userinfobot). Несколько — через запятую: 111111,222222
# Только они получают уведомления и могут добавлять/удалять службы.
TELEGRAM_ADMIN_ID=

# Название сервера в сообщениях
SERVER_NAME=QUIK Production

# Сервер, службы которого проверять (имя или IP). Пусто — этот же компьютер.
# Бот должен работать под учётной записью с правами администратора на этом сервере.
TARGET_HOST=

# Как часто проверять службы, секунд
CHECK_INTERVAL_SEC=30

# Необязательно: HTTP(S)-прокси, если сервер выходит в интернет только через прокси.
# Пример: http://proxy.local:3128
TELEGRAM_PROXY_URL=

# Необязательно
# TIMEZONE=Asia/Bishkek
# DATA_DIR=data
# LOG_DIR=logs
# LOG_LEVEL=info
